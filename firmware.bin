#define FW_CURRENT_VERSION "1.2"
#define GITHUB_VERSION_URL "https://raw.githubusercontent.com/sanok2006-ops/opel-dpf-monitor/main/version.json"

#define XPT2046_IRQ 36
#define XPT2046_MOSI 32
#define XPT2046_MISO 39
#define XPT2046_CLK 25
#define XPT2046_CS 33

XPT2046_Touchscreen ts(XPT2046_CS, XPT2046_IRQ);
TFT_eSPI tft = TFT_eSPI();
BluetoothSerial SerialBT;
Preferences prefs;

int dpf_soot = -1;
int dpf_regen = -1;
int dpf_km = -1;
int temp_coolant = -99;
float temp_exhaust = -99.0;
String voltage = "";

int last_soot = -999;
int last_regen = -999;
int last_km = -999;
int last_coolant = -999;
float last_exhaust = -999.0;
String last_voltage = "";
int last_regen_state = -1;

String savedMAC = "";
String btPin = "1234"; 
String savedSSID = "";
String savedPass = "";
uint8_t elm_mac[6] = {0,0,0,0,0,0};
bool elmConnected = false;

unsigned long lastRequest = 0;
unsigned long touchTimer = 0;

enum Screen { MAIN_SCREEN, SETTINGS_SCREEN, SCAN_SCREEN, WIFI_SCAN_SCREEN, KEYBOARD_SCREEN, OTA_STATUS_SCREEN, OTA_CONFIRM_SCREEN };
Screen currentScreen = MAIN_SCREEN;

#define MAX_DEVICES 20
String devNames[MAX_DEVICES];
String devMacs[MAX_DEVICES];
int devCount = 0;
int devPage = 0;

String selectedSSID = "";
String typedPassword = "";
bool shiftCaps = false;

String pendingVersion = "";
String pendingBinUrl = "";

void handleTouch();
void drawMainScreen();
void updateTiles();
void drawStatusBar();
void drawSettingsScreen();
void drawScanScreen();
void drawWiFiScanScreen();
void renderDeviceList(bool isWiFi);
void drawKeyboard();
void drawOtaStatus(String title, String subtitle, uint16_t color);
void drawOtaConfirmScreen(String newVer);
void connectToBT(int index);
void startWiFiProcess();
void checkGitHubUpdate();
void performDirectOTA(String binUrl);
void exitOtaToBluetooth();
void initELM327();
void requestData();
String sendOBDCommand(String cmd);
int parseHex(String response, int headerLen, int bytes);
void parseMacString(String macStr, uint8_t* macArr);

void setup() {
  Serial.begin(115200);
  
  prefs.begin("dpf_app", false);
  savedMAC = prefs.getString("mac", "");
  btPin = prefs.getString("pin", "1234"); 
  savedSSID = prefs.getString("ssid", "");
  savedPass = prefs.getString("pass", "");

  tft.init();
  tft.setRotation(1);
  tft.fillScreen(TFT_BLACK);
  
  SPI.begin(XPT2046_CLK, XPT2046_MISO, XPT2046_MOSI, XPT2046_CS);
  ts.begin();
  ts.setRotation(1);

  // Сплэш-заставка
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(TFT_YELLOW, TFT_BLACK);
  tft.drawString("DPF MONITOR OPEL", 160, 65, 4);
  
  tft.setTextColor(TFT_CYAN, TFT_BLACK);
  tft.drawString("by Sanya", 160, 105, 4);
  
  tft.setTextColor(TFT_DARKGREY, TFT_BLACK);
  tft.drawString("Firmware: v" + String(FW_CURRENT_VERSION), 160, 138, 2);
  
  tft.setTextColor(TFT_LIGHTGREY, TFT_BLACK);
  tft.drawString("Connecting Bluetooth...", 160, 195, 2);

  SerialBT.begin("ESP32_DPF", true); 
  SerialBT.setPin(btPin.c_str());    
  
  if (savedMAC != "") {
    parseMacString(savedMAC, elm_mac);
    elmConnected = SerialBT.connect(elm_mac);
    if (elmConnected) {
      initELM327();
    }
  }
  
  drawMainScreen();
}

void loop() {
  handleTouch();
  
  if (currentScreen == MAIN_SCREEN) {
    if (millis() - lastRequest > 800) {
      requestData();
      updateTiles();
      drawStatusBar();
      lastRequest = millis();
    }
  }
}

void initELM327() {
  sendOBDCommand("ATZ");   delay(300);
  sendOBDCommand("ATE0");
  sendOBDCommand("ATL0");
  sendOBDCommand("ATS0");  
  sendOBDCommand("ATSP0"); delay(300);
}

void requestData() {
  voltage = sendOBDCommand("ATRV");
  
  String ect = sendOBDCommand("0105");
  temp_coolant = parseHex(ect, 4, 1) - 40; 
  
  String soot = sendOBDCommand("223275");
  dpf_soot = parseHex(soot, 6, 1);
  
  String regen = sendOBDCommand("223274");
  dpf_regen = parseHex(regen, 6, 1);

  String km = sendOBDCommand("223277");
  dpf_km = parseHex(km, 6, 2);
  
  String egt = sendOBDCommand("0178");
  temp_exhaust = (parseHex(egt, 4, 2) / 10.0) - 40.0;
}

String sendOBDCommand(String cmd) {
  while (Serial.available()) Serial.read();
  if (elmConnected) while (SerialBT.available()) SerialBT.read();

  Serial.print(cmd + "\r");
  if (elmConnected) SerialBT.print(cmd + "\r");
  
  String response = "";
  unsigned long timeout = millis() + 350; 
  
  while (millis() < timeout) {
    handleTouch(); 
    if (Serial.available()) {
      char c = Serial.read();
      if (c == '>') break; 
      if (c != '\r' && c != '\n' && c != ' ') response += c;
    }
    if (elmConnected && SerialBT.available()) {
      char c = SerialBT.read();
      if (c == '>') break;
      if (c != '\r' && c != '\n' && c != ' ') response += c;
    }
  }
  return response;
}

int parseHex(String response, int headerLen, int bytes) {
  if (response.length() < headerLen + (bytes * 2)) return 0; 
  String dataHex = response.substring(headerLen, headerLen + (bytes * 2));
  return (int) strtol(dataHex.c_str(), NULL, 16);
}

void parseMacString(String macStr, uint8_t* macArr) {
  int index = 0;
  for (int i = 0; i < 6; i++) {
    macArr[i] = (uint8_t) strtol(macStr.substring(index, index + 2).c_str(), NULL, 16);
    index += 3;
  }
}

void drawTile(int x, int y, int w, int h, uint16_t color, String title) {
  tft.fillRoundRect(x, y, w, h, 6, TFT_BLACK); 
  tft.drawRoundRect(x, y, w, h, 6, TFT_DARKGREY); 
  tft.fillRoundRect(x + 1, y + 1, w - 2, 20, 5, color); 
  tft.fillRect(x + 1, y + 14, w - 2, 7, color); 
  
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(TFT_BLACK, color);     
  tft.drawString(title, x + (w / 2), y + 11, 2);
}

void updateTileValue(int x, int y, int w, int h, String value, uint16_t color) {
  tft.fillRect(x + 4, y + 22, w - 8, 38, TFT_BLACK);
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(color, TFT_BLACK);
  tft.drawString(value, x + (w / 2), y + 42, 4); 
}

void drawProgressBar(int x, int y, int w, int h, int percent, uint16_t color) {
  if (percent > 100) percent = 100;
  if (percent < 0) percent = 0;
  int fillWidth = map(percent, 0, 100, 0, w);
  tft.fillRect(x, y, fillWidth, h, color);
  tft.fillRect(x + fillWidth, y, w - fillWidth, h, TFT_DARKGREY);
}

void drawStatusBar() {
  int current_state = (dpf_regen > 0) ? 1 : 0;
  if (current_state == last_regen_state) return;
  last_regen_state = current_state;

  tft.fillRect(0, 0, 320, 24, TFT_DARKGREY);
  
  tft.fillRoundRect(4, 2, 60, 20, 4, TFT_BLACK);
  tft.drawRoundRect(4, 2, 60, 20, 4, TFT_WHITE);
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(TFT_WHITE, TFT_BLACK);
  tft.drawString("SET", 34, 12, 2);
  
  if (dpf_regen > 0) {
    tft.fillRoundRect(68, 2, 248, 20, 4, TFT_RED);
    tft.setTextColor(TFT_WHITE, TFT_RED);
    tft.drawString("DPF REGEN ACTIVE!", 192, 12, 2);
  } else {
    tft.setTextColor(TFT_WHITE, TFT_DARKGREY);
    tft.drawString("OPEL DPF MONITOR", 192, 12, 2);
  }
}

void drawMainScreen() {
  currentScreen = MAIN_SCREEN;
  tft.fillScreen(TFT_BLACK);
  
  last_soot = -999;
  last_regen = -999;
  last_km = -999;
  last_coolant = -999;
  last_exhaust = -999.0;
  last_voltage = "";
  last_regen_state = -1;

  drawStatusBar();
  
  drawTile(5, 28, 152, 67, TFT_YELLOW, "DPF SOOT");
  drawTile(163, 28, 152, 67, TFT_CYAN, "DPF REGEN");
  
  drawTile(5, 99, 152, 67, TFT_ORANGE, "EGT TEMP");
  drawTile(163, 99, 152, 67, TFT_PURPLE, "LAST REGEN");
  
  drawTile(5, 170, 152, 67, TFT_MAGENTA, "BATTERY");
  drawTile(163, 170, 152, 67, TFT_GREENYELLOW, "COOLANT");

  updateTiles();
}

void updateTiles() {
  if (currentScreen != MAIN_SCREEN) return;
  
  if (dpf_soot != last_soot) {
    uint16_t sootColor = (dpf_soot > 80) ? TFT_RED : TFT_GREEN;
    updateTileValue(5, 28, 152, 67, String(dpf_soot) + "%", sootColor);
    drawProgressBar(12, 87, 138, 5, dpf_soot, sootColor);
    last_soot = dpf_soot;
  }

  if (dpf_regen != last_regen) {
    uint16_t regenColor = (dpf_regen > 0) ? TFT_GREEN : TFT_WHITE;
    updateTileValue(163, 28, 152, 67, String(dpf_regen) + "%", regenColor);
    drawProgressBar(170, 87, 138, 5, dpf_regen, (dpf_regen > 0) ? TFT_GREEN : TFT_DARKGREY);
    last_regen = dpf_regen;
  }

  if ((int)temp_exhaust != (int)last_exhaust) {
    uint16_t egtColor;
    if (temp_exhaust < 300) egtColor = TFT_WHITE;
    else if (temp_exhaust <= 650) egtColor = TFT_GREEN;
    else egtColor = TFT_RED;
    updateTileValue(5, 99, 152, 67, String(temp_exhaust, 0) + " C", egtColor);
    last_exhaust = temp_exhaust;
  }

  if (dpf_km != last_km) {
    uint16_t kmColor = (dpf_km > 600) ? TFT_YELLOW : TFT_WHITE;
    updateTileValue(163, 99, 152, 67, String(dpf_km) + " km", kmColor);
    last_km = dpf_km;
  }

  if (voltage != last_voltage) {
    String v_str = voltage;
    v_str.replace("V", "");
    float v = v_str.toFloat();
    uint16_t voltColor;
    if (v < 12.0 || v > 14.5) voltColor = TFT_RED;
    else voltColor = TFT_GREEN;
    updateTileValue(5, 170, 152, 67, voltage, voltColor);
    last_voltage = voltage;
  }

  if (temp_coolant != last_coolant) {
    uint16_t colColor;
    if (temp_coolant < 60) colColor = TFT_BLUE;
    else if (temp_coolant <= 87) colColor = TFT_YELLOW;
    else if (temp_coolant <= 107) colColor = TFT_GREEN;
    else colColor = TFT_RED;
    updateTileValue(163, 170, 152, 67, String(temp_coolant) + " C", colColor);
    last_coolant = temp_coolant;
  }
}

