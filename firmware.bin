void drawScanScreen() {
  currentScreen = SCAN_SCREEN;
  devPage = 0;
  devCount = 0;
  
  tft.fillScreen(TFT_BLACK);
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(TFT_YELLOW, TFT_BLACK);
  tft.drawString("SCANNING BLUETOOTH...", 160, 100, 4);
  tft.setTextColor(TFT_CYAN, TFT_BLACK);
  tft.drawString("Please wait 8 sec...", 160, 135, 2);
  
  BTScanResults* pResults = SerialBT.discover(8000);
  
  if (pResults) {
    devCount = pResults->getCount();
    if (devCount > MAX_DEVICES) devCount = MAX_DEVICES;
    
    for (int i = 0; i < devCount; i++) {
      String name = pResults->getDevice(i)->getName().c_str();
      if (name.length() == 0) name = "Unknown Device";
      devNames[i] = name;
      devMacs[i] = pResults->getDevice(i)->getAddress().toString().c_str();
    }
  }
  
  renderDeviceList(false);
}

void drawWiFiScanScreen() {
  currentScreen = WIFI_SCAN_SCREEN;
  devPage = 0;
  devCount = 0;
  
  tft.fillScreen(TFT_BLACK);
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(TFT_YELLOW, TFT_BLACK);
  tft.drawString("SCANNING WI-FI...", 160, 100, 4);
  
  int n = WiFi.scanNetworks();
  if (n > 0) {
    devCount = (n > MAX_DEVICES) ? MAX_DEVICES : n;
    for (int i = 0; i < devCount; i++) {
      devNames[i] = WiFi.SSID(i);
    }
  }
  renderDeviceList(true);
}

void renderDeviceList(bool isWiFi) {
  tft.fillScreen(TFT_BLACK);
  
  tft.setTextDatum(TL_DATUM);
  tft.setTextColor(TFT_WHITE, TFT_BLACK);
  tft.drawString(isWiFi ? "SELECT WI-FI NETWORK:" : "SELECT ADAPTER:", 10, 5, 2);
  
  int totalPages = (devCount + 3) / 4;
  if (totalPages == 0) totalPages = 1;
  tft.setTextDatum(TR_DATUM);
  tft.setTextColor(TFT_YELLOW, TFT_BLACK);
  tft.drawString(String(devPage + 1) + "/" + String(totalPages), 310, 5, 2);
  
  if (devCount == 0) {
    tft.setTextDatum(MC_DATUM);
    tft.setTextColor(TFT_RED, TFT_BLACK);
    tft.drawString("NO NETWORKS FOUND!", 160, 95, 4);
  } else {
    int startIndex = devPage * 4;
    for (int i = 0; i < 4; i++) {
      int devIdx = startIndex + i;
      int y = 24 + (i * 38);
      
      if (devIdx < devCount) {
        tft.fillRoundRect(5, y, 310, 34, 5, TFT_NAVY);
        tft.drawRoundRect(5, y, 310, 34, 5, TFT_CYAN);
        tft.setTextDatum(MC_DATUM);
        tft.setTextColor(TFT_WHITE, TFT_NAVY);
        tft.drawString(devNames[devIdx], 160, y + 17, 2); 
      }
    }
  }

  tft.setTextDatum(MC_DATUM);
  tft.fillRoundRect(5, 185, 70, 48, 6, TFT_DARKGREY);
  tft.drawRoundRect(5, 185, 70, 48, 6, TFT_WHITE);
  tft.setTextColor(TFT_WHITE, TFT_DARKGREY);
  tft.drawString("BACK", 40, 209, 2);

  tft.fillRoundRect(80, 185, 75, 48, 6, (devPage > 0) ? TFT_BLUE : TFT_BLACK);
  tft.drawRoundRect(80, 185, 75, 48, 6, (devPage > 0) ? TFT_WHITE : TFT_DARKGREY);
  tft.setTextColor((devPage > 0) ? TFT_WHITE : TFT_DARKGREY, (devPage > 0) ? TFT_BLUE : TFT_BLACK);
  tft.drawString("UP", 117, 209, 2);

  bool hasNext = ((devPage + 1) * 4 < devCount);
  tft.fillRoundRect(160, 185, 75, 48, 6, hasNext ? TFT_BLUE : TFT_BLACK);
  tft.drawRoundRect(160, 185, 75, 48, 6, hasNext ? TFT_WHITE : TFT_DARKGREY);
  tft.setTextColor(hasNext ? TFT_WHITE : TFT_DARKGREY, hasNext ? TFT_BLUE : TFT_BLACK);
  tft.drawString("DOWN", 197, 209, 2);

  tft.fillRoundRect(240, 185, 75, 48, 6, TFT_DARKGREEN);
  tft.drawRoundRect(240, 185, 75, 48, 6, TFT_WHITE);
  tft.setTextColor(TFT_WHITE, TFT_DARKGREEN);
  tft.drawString("SCAN", 277, 209, 2);
}

const char* keysLower[] = {
  "1","2","3","4","5","6","7","8","9","0",
  "q","w","e","r","t","y","u","i","o","p",
  "a","s","d","f","g","h","j","k","l","-",
  "CAPS","z","x","c","v","b","n","m",".","DEL"
};
const char* keysUpper[] = {
  "!","@","#","$","%","^","&","*","(",")",
  "Q","W","E","R","T","Y","U","I","O","P",
  "A","S","D","F","G","H","J","K","L","_",
  "caps","Z","X","C","V","B","N","M","?","DEL"
};

void drawKeyboard() {
  currentScreen = KEYBOARD_SCREEN;
  tft.fillScreen(TFT_BLACK);
  
  tft.setTextDatum(TL_DATUM);
  tft.setTextColor(TFT_YELLOW, TFT_BLACK);
  tft.drawString("SSID: " + selectedSSID, 10, 4, 2);
  
  tft.fillRect(5, 22, 310, 26, TFT_NAVY);
  tft.drawRect(5, 22, 310, 26, TFT_WHITE);
  tft.setTextColor(TFT_WHITE, TFT_NAVY);
  tft.drawString("Pass: " + typedPassword + "_", 10, 27, 2);

  for (int row = 0; row < 4; row++) {
    for (int col = 0; col < 10; col++) {
      int idx = row * 10 + col;
      int x = 4 + col * 31;
      int y = 52 + row * 34;
      int w = 29;
      int h = 30;

      uint16_t btnCol = TFT_DARKGREY;
      if (idx == 30 || idx == 39) btnCol = TFT_BROWN;

      tft.fillRoundRect(x, y, w, h, 4, btnCol);
      tft.drawRoundRect(x, y, w, h, 4, TFT_WHITE);
      tft.setTextDatum(MC_DATUM);
      tft.setTextColor(TFT_WHITE, btnCol);
      tft.drawString(shiftCaps ? keysUpper[idx] : keysLower[idx], x + (w / 2), y + (h / 2), 2);
    }
  }

  tft.fillRoundRect(5, 192, 145, 42, 6, TFT_RED);
  tft.drawRoundRect(5, 192, 145, 42, 6, TFT_WHITE);
  tft.setTextColor(TFT_WHITE, TFT_RED);
  tft.drawString("CANCEL", 77, 213, 4);

  tft.fillRoundRect(165, 192, 145, 42, 6, TFT_DARKGREEN);
  tft.drawRoundRect(165, 192, 145, 42, 6, TFT_WHITE);
  tft.setTextColor(TFT_WHITE, TFT_DARKGREEN);
  tft.drawString("CONNECT", 237, 213, 4);
}

