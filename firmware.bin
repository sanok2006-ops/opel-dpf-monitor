void startWiFiProcess() {
  if (elmConnected) {
    SerialBT.disconnect();
    elmConnected = false;
  }
  SerialBT.end();
  
  WiFi.mode(WIFI_STA);
  
  if (savedSSID.length() > 0) {
    drawOtaStatus("CONNECTING WI-FI...", savedSSID, TFT_YELLOW);
    WiFi.begin(savedSSID.c_str(), savedPass.c_str());
    
    unsigned long startConn = millis();
    while (WiFi.status() != WL_CONNECTED && millis() - startConn < 10000) {
      delay(300);
    }
    
    if (WiFi.status() == WL_CONNECTED) {
      checkGitHubUpdate();
      return;
    }
  }
  
  drawWiFiScanScreen();
}

void checkGitHubUpdate() {
  drawOtaStatus("CHECKING GITHUB...", "Reading version.json", TFT_CYAN);
  
  WiFiClientSecure client;
  client.setInsecure(); 

  HTTPClient http;
  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
  
  String fetchUrl = String(GITHUB_VERSION_URL) + "?nocache=" + String(millis());
  http.begin(client, fetchUrl);
  
  int httpCode = http.GET();
  
  if (httpCode == HTTP_CODE_OK) {
    String payload = http.getString();
    http.end();
    
    int verIdx = payload.indexOf("\"version\"");
    int urlIdx = payload.indexOf("\"bin_url\"");

    if (verIdx != -1 && urlIdx != -1) {
      int vStart = payload.indexOf("\"", verIdx + 9) + 1;
      int vEnd = payload.indexOf("\"", vStart);
      pendingVersion = payload.substring(vStart, vEnd);
      pendingVersion.trim();

      int uStart = payload.indexOf("\"", urlIdx + 9) + 1;
      int uEnd = payload.indexOf("\"", uStart);
      pendingBinUrl = payload.substring(uStart, uEnd);
      pendingBinUrl.trim();

      if (pendingVersion != String(FW_CURRENT_VERSION) && pendingBinUrl.length() > 10) {
        drawOtaConfirmScreen(pendingVersion);
        return;
      } else {
        drawOtaStatus("LATEST VERSION!", "Server: v" + pendingVersion + " (Current: v" + String(FW_CURRENT_VERSION) + ")", TFT_GREEN);
        delay(2500);
        exitOtaToBluetooth();
        return;
      }
    } else {
      drawOtaStatus("PARSE ERROR!", "Raw: " + payload.substring(0, 20), TFT_RED);
      delay(3500);
      exitOtaToBluetooth();
      return;
    }
  } else {
    http.end();
    drawOtaStatus("SERVER ERROR!", "HTTP Code: " + String(httpCode), TFT_RED);
    delay(2500);
    exitOtaToBluetooth();
  }
}

// НАДЕЖНЫЙ ЗАГРУЗЧИК С ОТКЛЮЧЕНИЕМ WDT И ПРЯМОЙ СТРИМОВОЙ ЗАПИСЬЮ
void performDirectOTA(String binUrl) {
  drawOtaStatus("CONNECTING...", "Starting OTA download...", TFT_YELLOW);

  // Отключаем сторожевые таймеры для предотвращения Error 8 во время стирания секторов
  disableCore0WDT();
  disableLoopWDT();

  WiFiClientSecure client;
  client.setInsecure();
  client.setTimeout(30000); 

  HTTPClient http;
  http.setFollowRedirects(HTTPC_FORCE_FOLLOW_REDIRECTS);
  http.setTimeout(30000);
  http.begin(client, binUrl);

  int httpCode = http.GET();

  if (httpCode == HTTP_CODE_OK || httpCode == HTTP_CODE_MOVED_PERMANENTLY || httpCode == HTTP_CODE_FOUND) {
    int contentLength = http.getSize();
    
    tft.fillScreen(TFT_BLACK);
    tft.setTextDatum(MC_DATUM);
    tft.setTextColor(TFT_YELLOW, TFT_BLACK);
    tft.drawString("FLASHING v" + pendingVersion + "...", 160, 60, 4);
    tft.setTextColor(TFT_WHITE, TFT_BLACK);
    tft.drawString("Do not power off!", 160, 95, 2);

    tft.drawRect(38, 148, 244, 24, TFT_WHITE);

    // Подключаем callback шкалы прогресса
    Update.onProgress([](size_t progress, size_t total) {
      if (total > 0) {
        int percent = (progress * 100) / total;
        drawProgressBar(40, 150, 240, 20, percent, TFT_GREEN);
        tft.setTextDatum(MC_DATUM);
        tft.setTextColor(TFT_YELLOW, TFT_BLACK);
        tft.drawString(String(percent) + "%", 160, 190, 4);
      }
    });

    size_t updateSize = (contentLength > 10000) ? contentLength : UPDATE_SIZE_UNKNOWN;

    if (Update.begin(updateSize, U_FLASH)) {
      WiFiClient* stream = http.getStreamPtr();
      
      // Запись всего потока с автоматическим секторным буферизированием
      size_t written = Update.writeStream(*stream);

      if (Update.end(true)) {
        if (Update.isFinished()) {
          drawOtaStatus("SUCCESSFUL UPDATE!", "Rebooting...", TFT_GREEN);
          delay(2000);
          ESP.restart();
        } else {
          drawOtaStatus("OTA UNFINISHED!", "Written: " + String(written), TFT_RED);
        }
      } else {
        drawOtaStatus("FLASH ERROR!", "Code: " + String(Update.getError()), TFT_RED);
      }
    } else {
      drawOtaStatus("NO SPACE!", "Partition layout error", TFT_RED);
    }
  } else {
    drawOtaStatus("DOWNLOAD ERROR!", "HTTP: " + String(httpCode), TFT_RED);
  }

  http.end();
  enableCore0WDT();
  enableLoopWDT();
  delay(3000);
  exitOtaToBluetooth();
}

void exitOtaToBluetooth() {
  WiFi.disconnect(true);
  WiFi.mode(WIFI_OFF);
  
  tft.fillScreen(TFT_BLACK);
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(TFT_YELLOW, TFT_BLACK);
  tft.drawString("STARTING BLUETOOTH...", 160, 120, 4);
  
  SerialBT.begin("ESP32_DPF", true);
  SerialBT.setPin(btPin.c_str());
  
  if (savedMAC != "") {
    parseMacString(savedMAC, elm_mac);
    elmConnected = SerialBT.connect(elm_mac);
    if (elmConnected) initELM327();
  }
  
  drawMainScreen();
}

void connectToBT(int index) {
  tft.fillScreen(TFT_BLACK);
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(TFT_YELLOW, TFT_BLACK);
  tft.drawString("CONNECTING...", 160, 75, 4);
  tft.setTextColor(TFT_WHITE, TFT_BLACK);
  tft.drawString(devNames[index], 160, 115, 2);
  
  if (elmConnected) {
    SerialBT.disconnect();
    elmConnected = false;
  }
  
  parseMacString(devMacs[index], elm_mac);
  elmConnected = SerialBT.connect(elm_mac);
  
  if (elmConnected) {
    tft.setTextColor(TFT_GREEN, TFT_BLACK);
    tft.drawString("CONNECTED!", 160, 165, 4);
    
    savedMAC = devMacs[index];
    prefs.putString("mac", savedMAC);
    
    initELM327();
    delay(1200);
    drawMainScreen();
  } else {
    tft.setTextColor(TFT_RED, TFT_BLACK);
    tft.drawString("FAILED TO CONNECT!", 160, 165, 4);
    delay(2000);
    renderDeviceList(false);
  }
}

void handleTouch() {
  if (ts.touched() && (millis() - touchTimer > 350)) { 
    TS_Point p = ts.getPoint();
    int x = map(p.x, 300, 3800, 0, 320); 
    int y = map(p.y, 300, 3800, 0, 240);
    
    if (currentScreen == MAIN_SCREEN) {
      if (y < 28) {
        drawSettingsScreen();
        touchTimer = millis();
      }
    } 
    else if (currentScreen == SETTINGS_SCREEN) {
      if (y > 36 && y < 72) {
        if (btPin == "1234") btPin = "0000";
        else if (btPin == "0000") btPin = "6789";
        else if (btPin == "6789") btPin = "8888";
        else btPin = "1234";
        
        prefs.putString("pin", btPin);
        drawSettingsScreen();
        touchTimer = millis();
      }
      else if (y > 78 && y < 114) {
        drawScanScreen();
        touchTimer = millis();
      }
      else if (y > 120 && y < 156) {
        startWiFiProcess();
        touchTimer = millis();
      }
      else if (y > 162 && y < 200) {
        if (x < 155) {
          drawMainScreen();
          touchTimer = millis();
        } else {
          ESP.restart();
        }
      }
    }
    else if (currentScreen == SCAN_SCREEN) {
      if (y > 180) {
        if (x < 75) { drawSettingsScreen(); touchTimer = millis(); } 
        else if (x >= 80 && x < 155) { if (devPage > 0) { devPage--; renderDeviceList(false); touchTimer = millis(); } }
        else if (x >= 160 && x < 235) { if ((devPage + 1) * 4 < devCount) { devPage++; renderDeviceList(false); touchTimer = millis(); } }
        else if (x >= 240) { drawScanScreen(); touchTimer = millis(); }
      } else {
        for (int i = 0; i < 4; i++) {
          int itemY = 24 + (i * 38);
          if (y > itemY && y < itemY + 34) {
            int selectedIdx = (devPage * 4) + i;
            if (selectedIdx < devCount) { connectToBT(selectedIdx); touchTimer = millis(); break; }
          }
        }
      }
    }
    else if (currentScreen == WIFI_SCAN_SCREEN) {
      if (y > 180) {
        if (x < 75) { exitOtaToBluetooth(); touchTimer = millis(); } 
        else if (x >= 80 && x < 155) { if (devPage > 0) { devPage--; renderDeviceList(true); touchTimer = millis(); } }
        else if (x >= 160 && x < 235) { if ((devPage + 1) * 4 < devCount) { devPage++; renderDeviceList(true); touchTimer = millis(); } }
        else if (x >= 240) { drawWiFiScanScreen(); touchTimer = millis(); }
      } else {
        for (int i = 0; i < 4; i++) {
          int itemY = 24 + (i * 38);
          if (y > itemY && y < itemY + 34) {
            int selectedIdx = (devPage * 4) + i;
            if (selectedIdx < devCount) {
              selectedSSID = devNames[selectedIdx];
              typedPassword = "";
              drawKeyboard();
              touchTimer = millis();
              break;
            }
          }
        }
      }
    }
    else if (currentScreen == KEYBOARD_SCREEN) {
      if (y > 192) {
        if (x < 155) {
          drawWiFiScanScreen();
          touchTimer = millis();
        } else {
          drawOtaStatus("CONNECTING...", selectedSSID, TFT_YELLOW);
          WiFi.begin(selectedSSID.c_str(), typedPassword.c_str());
          
          unsigned long startConn = millis();
          while (WiFi.status() != WL_CONNECTED && millis() - startConn < 10000) {
            delay(300);
          }
          
          if (WiFi.status() == WL_CONNECTED) {
            savedSSID = selectedSSID;
            savedPass = typedPassword;
            prefs.putString("ssid", savedSSID);
            prefs.putString("pass", savedPass);
            checkGitHubUpdate();
          } else {
            drawOtaStatus("FAILED TO CONNECT!", "Wrong password?", TFT_RED);
            delay(2000);
            drawKeyboard();
          }
          touchTimer = millis();
        }
      } 
      else if (y >= 52 && y < 188) {
        int row = (y - 52) / 34;
        int col = (x - 4) / 31;
        if (row >= 0 && row < 4 && col >= 0 && col < 10) {
          int idx = row * 10 + col;
          if (idx == 30) {
            shiftCaps = !shiftCaps;
            drawKeyboard();
          } else if (idx == 39) {
            if (typedPassword.length() > 0) {
              typedPassword.remove(typedPassword.length() - 1);
              tft.fillRect(5, 22, 310, 26, TFT_NAVY);
              tft.drawRect(5, 22, 310, 26, TFT_WHITE);
              tft.setTextColor(TFT_WHITE, TFT_NAVY);
              tft.setTextDatum(TL_DATUM);
              tft.drawString("Pass: " + typedPassword + "_", 10, 27, 2);
            }
          } else {
            typedPassword += shiftCaps ? keysUpper[idx] : keysLower[idx];
            tft.fillRect(5, 22, 310, 26, TFT_NAVY);
            tft.drawRect(5, 22, 310, 26, TFT_WHITE);
            tft.setTextColor(TFT_WHITE, TFT_NAVY);
            tft.setTextDatum(TL_DATUM);
            tft.drawString("Pass: " + typedPassword + "_", 10, 27, 2);
          }
          touchTimer = millis();
        }
      }
    }
    else if (currentScreen == OTA_CONFIRM_SCREEN) {
      if (y >= 170 && y <= 230) {
        if (x < 155) {
          exitOtaToBluetooth();
          touchTimer = millis();
        } else {
          performDirectOTA(pendingBinUrl);
          touchTimer = millis();
        }
      }
    }
  }
}